includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    treatPhpDocTypesAsCertain: false

    paths:
        - app/

    # Level 9 is the highest level
    level: 4

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Ignore repository interface missing methods
        - '#Call to an undefined method DarkOak\\Repositories\\Wings\\DaemonRepository::(\w+)\(\)#'

        # Ignore magic spatie calls
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder.*::allowed(\w+)\(\)#'

        # StripeObject has dynamic properties (metadata)
        - '#Access to an undefined property Stripe\\StripeObject::#'

        # Optional WebPush dependency is not always installed
        - '#(Class|Instantiated class|unknown class) Minishlink\\WebPush#'
        - '#Call to (method|static method).*Minishlink\\WebPush#'

        # AI request classes are not yet implemented
        - '#unknown class DarkOak\\Http\\Requests\\Api\\Application\\Intelligence#'
        - '#has invalid type DarkOak\\Http\\Requests\\Api\\Application\\Intelligence#'
        - '#Call to method (normalize|all|input)\(\) on an unknown class DarkOak\\Http\\Requests\\Api\\Application\\Intelligence#'

        # Nullsafe with coalesce is intentional where relation may be null
        - '#Using nullsafe property access .* is unnecessary#'

        # Lazy config/env access in middleware / service provider (acceptable here)
        - '#Called .env. outside of the config directory#'
        - '#Access to an undefined property Illuminate\\Contracts\\Foundation\\Application::\$config#'

        # ResourcePrice map closure inference (docblock coverage incomplete)
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$id#'

        # Stripe intent status literal comparison is intentional
        - '#identical\.alwaysTrue#'
        - '#notIdentical\.alwaysTrue#'
        - '#identical\.alwaysFalse#'

        # Strict comparisons against known literals are intentional (Stripe, enums)
        - '#Strict comparison using (===|!==) between .* will always evaluate to (true|false)#'

        # Missing services / not-yet-implemented features
        - '#Call to an undefined method DarkOak\\Models\\Node::guzzleClient\(\)#'
        - '#Call to an undefined method DarkOak\\Models\\User::passkeys\(\)#'
        - '#Class DarkOak\\Services\\Servers\\ServerCreationService constructor#'
        - '#has invalid type DarkOak\\Services\\Servers\\ServerUpdateService#'
        - '#has unknown class DarkOak\\Services\\Servers\\ServerUpdateService#'

        # Missing repositories (excluded path)
        - '#Class DarkOak\\Contracts\\Repository\\LocationRepositoryInterface not found#'
        - '#Class DarkOak\\Repositories\\Eloquent\\LocationRepository not found#'

        # Missing model methods (will be added later)
        - '#Call to an undefined method DarkOak\\Models\\User::createAsStripeCustomer\(\)#'
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder.*ordered\(\)#'

        # Missing model relations
        - '#Relation .paymentIntent. is not found#'
        - '#Relation .permissions. is not found#'

        # Model properties loaded via loadSum/loadCount
        - '#Access to an undefined property DarkOak\\Models\\Node::\$location_id#'
        - '#Access to an undefined property DarkOak\\Models\\Egg::\$image#'

        # Socialite interface has dynamic properties
        - '#Access to an undefined property Laravel\\Socialite\\Contracts\\User::#'

        # ThemePaletteService uses dynamic object properties
        - '#Access to an undefined property object::\$value#'

        # Unused properties (constructor property promotion, DI only)
        - '#Property.*is never read, only written#'
        - '#Method.*is unused#'

        # Unreachable statements after throw/return
        - '#Unreachable statement#'
        - '#Dead catch -.*is never thrown in the try block#'

        # Always-true/false conditions from type narrowing
        - '#Left side of && is always true#'
        - '#Instanceof between null and.*will always evaluate to false#'
        - '#Call to function is_null\(\) with.*will always evaluate to false#'
        - '#Offset.*on left side of \?\? always exists and is not nullable#'

        # Static access to instance property
        - '#Static access to instance property#'

        # Deprecated in PHP 8.4
        - '#Deprecated in PHP 8\.4#'
        - '#Anonymous function has an unused use#'
        - '#Using nullsafe method call on non-nullable type#'

        # Unused new traits are intentional placeholders
        - '#Trait .* is used zero times and is not analysed#'

    excludePaths:
        - app/Repositories

        # More magic spatie to be replaced
        - app/Extensions/Spatie/Fractalistic/Fractal.php
