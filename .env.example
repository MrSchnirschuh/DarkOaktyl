APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=UTC
APP_URL=http://panel.example.com
APP_LOCALE=en
APP_ENVIRONMENT_ONLY=true

# Domain configuration for DarkOak custom installation
# Leave APP_ROOT_DOMAIN empty to disable domain separation
# When set, public website will be at APP_ROOT_DOMAIN and panel at PANEL_SUBDOMAIN.APP_ROOT_DOMAIN
APP_ROOT_DOMAIN=
PANEL_SUBDOMAIN=panel

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=DarkOaktyl
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

HASHIDS_SALT=
HASHIDS_LENGTH=8

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="DarkOaktyl"

# Stripe Configuration
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET=sk_test_your_secret_key_here

# Webhook Security - CRITICAL for preventing payment fraud
# Get this from your Stripe Dashboard: https://dashboard.stripe.com/webhooks
# This secret verifies that webhooks actually came from Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Webhook tolerance in seconds (default: 300 = 5 minutes)
STRIPE_WEBHOOK_TOLERANCE=300

# OAuth2 Configuration
# Discord OAuth2 - Get credentials from https://discord.com/developers/applications
DISCORD_OAUTH_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth2 - Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# VAPID Configuration for Web Push Notifications
# Generate keys with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Security Headers
APP_FORCE_HTTPS=false
APP_CSP_HEADER=

# CORS (comma-separated origins)
APP_CORS_ALLOWED_ORIGINS=
